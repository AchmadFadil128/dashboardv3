<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Writing Form - Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <h2><%= id ? 'Edit Writing' : 'Create Writing' %></h2>
        <div class="card shadow-sm mt-3">
          <div class="card-body">
            <form id="data-form">
              <div class="mb-3">
                <label class="form-label">Title</label>
                <input type="text" id="name" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Short Description</label>
                <textarea id="shortDescription" class="form-control" rows="3"></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label">URL / File Link</label>
                <div class="input-group">
                  <input type="text" id="urlFile" class="form-control">
                  <input type="file" id="fileUpload" class="form-control" style="display: none;">
                  <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('fileUpload').click()">Upload to SeaweedFS</button>
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Status</label>
                  <select id="status" class="form-select">
                    <option value="Planned">Planned</option>
                    <option value="In Progress">In Progress</option>
                    <option value="On Hold">On Hold</option>
                    <option value="Completed">Completed</option>
                    <option value="Published">Published</option>
                  </select>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Date Created</label>
                  <input type="date" id="dateCreate" class="form-control">
                </div>
              </div>
              <button type="submit" class="btn btn-primary">Save Writing</button>
              <a href="/dashboard/writings" class="btn btn-secondary">Cancel</a>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const itemId = '<%= id %>';

    async function loadData() {
      if (itemId) {
        try {
          const res = await authFetch(`/api/writings/${itemId}`);
          const { data } = await res.json();
          document.getElementById('name').value = data.name || '';
          document.getElementById('shortDescription').value = data.shortDescription || '';
          document.getElementById('urlFile').value = data.urlFile || '';
          document.getElementById('status').value = data.status || 'Planned';
          
          if (data.dateCreate) {
            document.getElementById('dateCreate').value = new Date(data.dateCreate).toISOString().split('T')[0];
          }
        } catch (err) {
          console.error(err);
          alert('Failed to load writing data');
        }
      }
    }

    document.getElementById('data-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const body = JSON.stringify({
        name: document.getElementById('name').value,
        shortDescription: document.getElementById('shortDescription').value,
        urlFile: document.getElementById('urlFile').value,
        status: document.getElementById('status').value,
        dateCreate: document.getElementById('dateCreate').value || undefined
      });

      try {
        const method = itemId ? 'PUT' : 'POST';
        const url = itemId ? `/api/writings/${itemId}` : '/api/writings';
        const res = await authFetch(url, { method, body });
        
        if (res.ok) {
          window.location.href = '/dashboard/writings';
        } else {
          const data = await res.json();
          alert('Error: ' + JSON.stringify(data.error));
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred while saving.');
      }
    });

    document.getElementById('fileUpload').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      try {
        const token = localStorage.getItem('token');
        const res = await fetch('/api/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          body: formData
        });

        if (res.ok) {
          const { data } = await res.json();
          document.getElementById('urlFile').value = data.url;
          alert('Upload successful!');
        } else {
          const errData = await res.json();
          alert('Upload failed: ' + errData.error);
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred during upload.');
      }
    });

    loadData();
  </script>
</body>
</html>
