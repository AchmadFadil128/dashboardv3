<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Project Form - Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <h2><%= id ? 'Edit Project' : 'Create Project' %></h2>
        <div class="card shadow-sm mt-3">
          <div class="card-body">
            <form id="data-form">
              <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" id="name" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Picture URL</label>
                <div class="input-group">
                  <input type="text" id="pictureUrl" class="form-control">
                  <input type="file" id="pictureUpload" class="form-control" style="display: none;">
                  <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('pictureUpload').click()">Upload to SeaweedFS</button>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Short Description</label>
                <textarea id="shortDescription" class="form-control" rows="2"></textarea>
              </div>
              <div class="mb-3">
                <label class="form-label">Long Description</label>
                <textarea id="longDescription" class="form-control" rows="4"></textarea>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Status</label>
                  <select id="status" class="form-select">
                    <option value="Planned">Planned</option>
                    <option value="In Progress">In Progress</option>
                    <option value="On Hold">On Hold</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                  </select>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Date Created</label>
                  <input type="date" id="dateCreate" class="form-control">
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label">Tech Stack (JSON Array)</label>
                <input type="text" id="techStack" class="form-control" placeholder='["React", "Node.js"]'>
              </div>
              <div class="mb-3">
                <label class="form-label">Other Pictures (JSON Array)</label>
                <input type="text" id="otherPictures" class="form-control" placeholder='["url1", "url2"]'>
              </div>
              <div class="mb-3">
                <label class="form-label">External URL Project</label>
                <input type="url" id="exturlproject" class="form-control" placeholder="https://example.com">
              </div>
              <button type="submit" class="btn btn-primary">Save Project</button>
              <a href="/dashboard/projects" class="btn btn-secondary">Cancel</a>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const itemId = '<%= id %>';

    async function loadData() {
      if (itemId) {
        try {
          const res = await authFetch(`/api/projects/${itemId}`);
          const { data } = await res.json();
          document.getElementById('name').value = data.name || '';
          document.getElementById('pictureUrl').value = data.pictureUrl || '';
          document.getElementById('shortDescription').value = data.shortDescription || '';
          document.getElementById('longDescription').value = data.longDescription || '';
          document.getElementById('status').value = data.status || 'Planned';
          
          if (data.dateCreate) {
            document.getElementById('dateCreate').value = new Date(data.dateCreate).toISOString().split('T')[0];
          }
          
          if (data.techStack) {
            document.getElementById('techStack').value = typeof data.techStack === 'string' ? data.techStack : JSON.stringify(data.techStack);
          }
          if (data.otherPictures) {
            document.getElementById('otherPictures').value = typeof data.otherPictures === 'string' ? data.otherPictures : JSON.stringify(data.otherPictures);
          }
          document.getElementById('exturlproject').value = data.exturlproject || '';
        } catch (err) {
          console.error(err);
          alert('Failed to load project data');
        }
      }
    }

    document.getElementById('data-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      let techStack = document.getElementById('techStack').value;
      let otherPictures = document.getElementById('otherPictures').value;

      const body = JSON.stringify({
        name: document.getElementById('name').value,
        pictureUrl: document.getElementById('pictureUrl').value,
        shortDescription: document.getElementById('shortDescription').value,
        longDescription: document.getElementById('longDescription').value,
        status: document.getElementById('status').value,
        dateCreate: document.getElementById('dateCreate').value || undefined,
        techStack: techStack ? JSON.parse(techStack) : [],
        otherPictures: otherPictures ? JSON.parse(otherPictures) : [],
        exturlproject: document.getElementById('exturlproject').value || ''
      });

      try {
        const method = itemId ? 'PUT' : 'POST';
        const url = itemId ? `/api/projects/${itemId}` : '/api/projects';
        const res = await authFetch(url, { method, body });
        
        if (res.ok) {
          window.location.href = '/dashboard/projects';
        } else {
          const data = await res.json();
          alert('Error: ' + JSON.stringify(data.error));
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred while saving.');
      }
    });

    document.getElementById('pictureUpload').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      try {
        const token = localStorage.getItem('token');
        const res = await fetch('/api/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          body: formData
        });

        if (res.ok) {
          const { data } = await res.json();
          document.getElementById('pictureUrl').value = data.url;
          alert('Upload successful!');
        } else {
          const errData = await res.json();
          alert('Upload failed: ' + errData.error);
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred during upload.');
      }
    });

    loadData();
  </script>
</body>
</html>
