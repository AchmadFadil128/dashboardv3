<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Certifications - Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  
  <div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2>Certifications</h2>
      <a href="/dashboard/certifications/create" class="btn btn-primary">Add Certification</a>
    </div>
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>Name</th>
              <th>Issuer</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="table-body">
            <tr><td colspan="4" class="text-center">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    async function loadData() {
      try {
        const res = await authFetch('/api/certifications');
        const { data } = await res.json();
        const tbody = document.getElementById('table-body');
        
        if (data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="text-center">No certifications found.</td></tr>';
          return;
        }

        tbody.innerHTML = data.map(item => `
          <tr>
            <td><strong>${item.name}</strong></td>
            <td>${item.issuer || '-'}</td>
            <td><span class="badge bg-${item.status === 'Active' ? 'success' : 'secondary'}">${item.status}</span></td>
            <td class="text-end">
              <a href="/dashboard/certifications/edit/${item.id}" class="btn btn-sm btn-warning">Edit</a>
              <button onclick="deleteItem('${item.id}')" class="btn btn-sm btn-danger">Delete</button>
            </td>
          </tr>
        `).join('');
      } catch (err) {
        console.error(err);
        document.getElementById('table-body').innerHTML = '<tr><td colspan="4" class="text-center text-danger">Failed to load data.</td></tr>';
      }
    }

    async function deleteItem(id) {
      if (confirm('Are you sure you want to delete this certification?')) {
        try {
          await authFetch(`/api/certifications/${id}`, { method: 'DELETE' });
          loadData();
        } catch (err) {
          alert('Failed to delete item');
        }
      }
    }

    loadData();
  </script>
</body>
</html>
