<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Certification Form - Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  
  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <h2><%= id ? 'Edit Certification' : 'Create Certification' %></h2>
        <div class="card shadow-sm mt-3">
          <div class="card-body">
            <form id="data-form">
              <div class="mb-3">
                <label class="form-label">Name</label>
                <input type="text" id="name" class="form-control" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Issuer</label>
                <input type="text" id="issuer" class="form-control">
              </div>
              <div class="mb-3">
                <label class="form-label">Picture URL</label>
                <div class="input-group">
                  <input type="text" id="pictureUrl" class="form-control">
                  <input type="file" id="pictureUpload" class="form-control" style="display: none;">
                  <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('pictureUpload').click()">Upload to SeaweedFS</button>
                </div>
              </div>
              <div class="mb-3">
                  <label class="form-label">Status</label>
                  <select id="status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Near Expiry">Near Expiry</option>
                    <option value="Expired">Expired</option>
                  </select>
              </div>
              <button type="submit" class="btn btn-primary">Save Certification</button>
              <a href="/dashboard/certifications" class="btn btn-secondary">Cancel</a>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const itemId = '<%= id %>';

    async function loadData() {
      if (itemId) {
        try {
          const res = await authFetch(`/api/certifications/${itemId}`);
          const { data } = await res.json();
          document.getElementById('name').value = data.name || '';
          document.getElementById('issuer').value = data.issuer || '';
          document.getElementById('pictureUrl').value = data.pictureUrl || '';
          document.getElementById('status').value = data.status || 'Active';
        } catch (err) {
          console.error(err);
          alert('Failed to load certification data');
        }
      }
    }

    document.getElementById('data-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const body = JSON.stringify({
        name: document.getElementById('name').value,
        issuer: document.getElementById('issuer').value,
        pictureUrl: document.getElementById('pictureUrl').value,
        status: document.getElementById('status').value
      });

      try {
        const method = itemId ? 'PUT' : 'POST';
        const url = itemId ? `/api/certifications/${itemId}` : '/api/certifications';
        const res = await authFetch(url, { method, body });
        
        if (res.ok) {
          window.location.href = '/dashboard/certifications';
        } else {
          const data = await res.json();
          alert('Error: ' + JSON.stringify(data.error));
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred while saving.');
      }
    });

    document.getElementById('pictureUpload').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      try {
        const token = localStorage.getItem('token');
        const res = await fetch('/api/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`
          },
          body: formData
        });

        if (res.ok) {
          const { data } = await res.json();
          document.getElementById('pictureUrl').value = data.url;
          alert('Upload successful!');
        } else {
          const errData = await res.json();
          alert('Upload failed: ' + errData.error);
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred during upload.');
      }
    });

    loadData();
  </script>
</body>
</html>
